{
  "description": "BIP-174 PSBT Test Vectors for OpenSY",
  "source": "https://github.com/bitcoin/bips/blob/master/bip-0174.mediawiki",
  "version": "1.0.0",
  "test_cases": [
    {
      "id": "valid_psbt_1",
      "description": "Valid PSBT with one P2PKH input and two outputs",
      "input_hex": "",
      "expected_valid": true,
      "comment": "Standard PSBT with UTXO data"
    },
    {
      "id": "valid_psbt_2",
      "description": "Valid PSBT with one P2WPKH input",
      "input_hex": "70736274ff0100520200000001aad73931018bd25f84ae400b68df0b1b91ca4a8f5dfc5dca6f3b99b71c54a8b80000000000ffffffff0110270000000000001976a914e4b65e0a9e1f5e8ed1d66a8db60169c1f48e4e3d88ac0000000000010120955eea00000000001600145f275f436b09a8cc9a2eb2a2f528485c68a56323ffffffff",
      "expected_valid": true,
      "comment": "SegWit input PSBT"
    },
    {
      "id": "invalid_magic",
      "description": "Invalid PSBT - wrong magic bytes",
      "input_hex": "00000000ff0100520200000001aad73931018bd25f84ae400b68df0b1b91ca4a8f5dfc5dca6f3b99b71c54a8b80000000000ffffffff0110270000000000001976a914e4b65e0a9e1f5e8ed1d66a8db60169c1f48e4e3d88ac0000000000010120955eea00000000001600145f275f436b09a8cc9a2eb2a2f528485c68a56323ffffffff",
      "expected_valid": false,
      "expected_error": "InvalidMagic",
      "comment": "Magic bytes should be 0x70736274"
    },
    {
      "id": "invalid_separator",
      "description": "Invalid PSBT - missing separator",
      "input_hex": "70736274010100520200000001aad73931018bd25f84ae400b68df0b1b91ca4a8f5dfc5dca6f3b99b71c54a8b80000000000ffffffff0110270000000000001976a914e4b65e0a9e1f5e8ed1d66a8db60169c1f48e4e3d88ac0000000000010120955eea00000000001600145f275f436b09a8cc9a2eb2a2f528485c68a56323ffffffff",
      "expected_valid": false,
      "expected_error": "InvalidSeparator",
      "comment": "Separator byte should be 0xff after magic"
    },
    {
      "id": "unsigned_tx_key",
      "description": "PSBT with unsigned transaction",
      "key_type": "0x00",
      "key_description": "Unsigned transaction",
      "expected_unique": true,
      "comment": "Key 0x00 must be unique in global map"
    },
    {
      "id": "witness_utxo",
      "description": "PSBT with witness UTXO",
      "key_type": "0x01",
      "key_description": "Witness UTXO",
      "per_input": true,
      "comment": "Used for SegWit inputs"
    },
    {
      "id": "non_witness_utxo",
      "description": "PSBT with non-witness UTXO",
      "key_type": "0x00",
      "key_description": "Non-witness UTXO (full prev tx)",
      "per_input": true,
      "comment": "Used for legacy inputs"
    },
    {
      "id": "partial_sig",
      "description": "PSBT with partial signature",
      "key_type": "0x02",
      "key_description": "Partial signature",
      "per_input": true,
      "key_data": "public_key",
      "value_data": "signature",
      "comment": "Can have multiple partial sigs per input"
    },
    {
      "id": "sighash_type",
      "description": "PSBT with sighash type",
      "key_type": "0x03",
      "key_description": "Sighash type",
      "per_input": true,
      "value_format": "4-byte little-endian",
      "valid_values": [1, 2, 3, 129, 130, 131],
      "comment": "SIGHASH_ALL=1, SIGHASH_NONE=2, SIGHASH_SINGLE=3"
    },
    {
      "id": "redeem_script",
      "description": "PSBT with redeem script",
      "key_type": "0x04",
      "key_description": "Redeem script",
      "per_input": true,
      "comment": "For P2SH inputs"
    },
    {
      "id": "witness_script",
      "description": "PSBT with witness script",
      "key_type": "0x05",
      "key_description": "Witness script",
      "per_input": true,
      "comment": "For P2WSH inputs"
    },
    {
      "id": "bip32_derivation",
      "description": "PSBT with BIP32 derivation path",
      "key_type": "0x06",
      "key_description": "BIP32 derivation",
      "per_input": true,
      "key_data": "public_key",
      "value_data": "fingerprint + path",
      "comment": "For hardware wallet signing"
    },
    {
      "id": "finalized_scriptsig",
      "description": "PSBT with finalized scriptSig",
      "key_type": "0x07",
      "key_description": "Final scriptSig",
      "per_input": true,
      "comment": "Indicates input is fully signed (legacy)"
    },
    {
      "id": "finalized_witness",
      "description": "PSBT with finalized witness",
      "key_type": "0x08",
      "key_description": "Final witness",
      "per_input": true,
      "comment": "Indicates input is fully signed (SegWit)"
    }
  ],
  "serialization_tests": [
    {
      "id": "round_trip_1",
      "description": "Serialize and deserialize should produce identical bytes",
      "input_hex": ""
    }
  ],
  "opensy_specific_tests": [
    {
      "id": "opensy_network_1",
      "description": "PSBT for OpenSY mainnet transaction",
      "network": "mainnet",
      "coin_type": 9633,
      "derivation_path": "m/84'/9633'/0'/0/0",
      "comment": "Standard OpenSY SegWit derivation"
    },
    {
      "id": "opensy_testnet_1",
      "description": "PSBT for OpenSY testnet transaction",
      "network": "testnet",
      "coin_type": 1,
      "derivation_path": "m/84'/1'/0'/0/0",
      "comment": "Testnet uses coin type 1"
    }
  ]
}
